# Frontend (development only)
VITE_API_URL=http://localhost:3001/api

# Server
PORT=3000
SERVER_PORT=3001
CORS_ORIGIN=http://localhost:3000

# Database (use internal Docker hostname in production)
# Development: postgresql://user:password@localhost:5433/fbg_planning
# Production:  postgresql://user:password@postgres:5432/fbg_planning
DATABASE_URL=postgresql://user:password@postgres:5432/fbg_planning

# Directus Auth
DIRECTUS_URL=https://cms.businessfalkenberg.se

# AI providers (server-side only). Both can be set; the model dropdown picks
# which one a request uses. Default model is mistral-medium-3.5 (Mistral, EU).
GEMINI_API_KEY=your_gemini_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
